@baseUrl = http://localhost:5136

### List all documents
GET {{baseUrl}}/documents

### Get one document that exists
GET {{baseUrl}}/documents/1

### Get one document that does not exist
GET {{baseUrl}}/documents/99

### Create a document (expect 201)
POST {{baseUrl}}/documents
Content-Type: application/json

{
  "lawId": 1,
  "sourceUrl": "https://example.com/reglamento-2027.pdf",
  "effectiveDate": "2027-01-01"
}

### Create a document with a missing field (expect 400)
POST {{baseUrl}}/documents
Content-Type: application/json

{
  "lawId": 1,
  "effectiveDate": "2027-01-01"
}

### Route that does not exist (expect empty 404)
GET {{baseUrl}}/libros/1
